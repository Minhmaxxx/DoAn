# Google AI Studio / Gemini Developer API.
# Cùng API key này có thể gọi model Gemini hoặc Gemma được AI Studio hỗ trợ.
GEMINI_API_KEY=

# Backend LLM đang dùng: 'google' hoặc 'openai'.
LLM_PROVIDER=google

# Có thể thay bằng model ID Gemma chính xác hiển thị trong AI Studio.
GOOGLE_MODEL=gemini-3.5-flash

# OpenAI là phương án dự phòng không bắt buộc.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Chỉ bật khi phát triển giao diện mà không có checkpoint thật.
ENABLE_RANDOM_DEMO=false

# Token tại https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Cổng local được run_ngrok.py sử dụng.
STREAMLIT_PORT=8501
