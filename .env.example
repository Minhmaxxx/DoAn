# Google Gemini API Key (recommended - free tier available at aistudio.google.com)
GEMINI_API_KEY=

# OpenAI API Key (backup option)
OPENAI_API_KEY=

# Active LLM provider: 'gemini' or 'openai'
LLM_PROVIDER=gemini

# Chỉ bật khi phát triển giao diện mà không có checkpoint thật.
ENABLE_RANDOM_DEMO=false

# Token miễn phí tại https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Cổng local được run_ngrok.py sử dụng.
STREAMLIT_PORT=8501
