# =============================================================================
# .gitignore — NutriVision Project
# =============================================================================

# --- Python ---
__pycache__/
.pytest_cache/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# --- Virtual Environments ---
.venv/
.venv311/
venv/
ENV/
env/
.env
.env.*
!.env.example

# --- Streamlit Secrets (NEVER commit this!) ---
.streamlit/secrets.toml
.streamlit/credentials.toml

# --- Credentials and local databases ---
*.pem
*.key
credentials*.json
service-account*.json
*.db
*.db-journal
*.sqlite
*.sqlite3

# --- Model Weights ---
models/weights/*.pt
models/weights/*.onnx
models/weights/*.engine
models/weights/*.tflite
# The validated 5.97 MB production checkpoint is required by clean deploys.
!models/weights/best_baseline_B.pt

# --- Training Artifacts ---
runs/
*.pt.backup
train_results/
KetQuaTrain/

# --- Data (large files) ---
data/sample_images/*
!data/sample_images/.gitkeep
data/meal_history.json
test_model/weights_test/
test_model/anh_test/
test_model/benchmark_common_v1/images/*
# Keep only the two small release-gate fixtures used by pytest.
!test_model/benchmark_common_v1/images/1002_jpg.rf.4de4b051a6630d45d1024bd6e112a996.jpg
!test_model/benchmark_common_v1/images/bg_002_jpg.rf.f428a7380f308f462b9418be9d579d54.jpg
test_model/benchmark_common_v1/labels/
test_model/benchmark_results_common_v1/Baseline_*/
test_model/Ket_Qua_So_Sanh/

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*.ipynb
notebooks/*.pdf

# --- Reports (backed up outside Git) ---
*.docx

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/

# --- Test and analysis output ---
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Roboflow downloads ---
*.zip
datasets/

CLAUDE.md
