# =============================================================================
# .gitignore — NutriVision Project
# =============================================================================

# --- Python ---
__pycache__/
.pytest_cache/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# --- Virtual Environments ---
.venv/
.venv311/
venv/
ENV/
env/
.env

# --- Streamlit Secrets (NEVER commit this!) ---
.streamlit/secrets.toml

# --- Model Weights (too large for Git, use Git LFS or share separately) ---
models/weights/*.pt
models/weights/*.onnx
models/weights/*.engine
models/weights/*.tflite

# --- Training Artifacts ---
runs/
*.pt.backup
train_results/
KetQuaTrain/

# --- Data (large files) ---
data/sample_images/*
!data/sample_images/.gitkeep
data/meal_history.json
test_model/weights_test/
test_model/anh_test/
test_model/benchmark_common_v1/images/
test_model/benchmark_common_v1/labels/
test_model/benchmark_results_common_v1/Baseline_*/
test_model/Ket_Qua_So_Sanh/

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*.ipynb
notebooks/*.pdf

# --- Reports (backed up outside Git) ---
*.docx

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/

# --- Roboflow downloads ---
*.zip
datasets/
