# Copy this file to .streamlit/secrets.toml (gitignored, never commit the real
# one) and fill in the values from Supabase -> Settings -> API.
#
# Both values below are safe to handle normally: the anon/publishable key is
# meant to be public (it's the same key the browser would use), row-level
# security in storage_schema.sql is what actually protects data. Never put
# the "service_role" key here or anywhere in this repo.

[supabase]
url = "https://<project-ref>.supabase.co"
publishable_key = "<anon-public-key>"

# Optional. Where Google sends the user back after linking an account. Leave it
# out in production so Supabase uses the Site URL from its own dashboard; set it
# locally (http://localhost:8501) so a dev login doesn't bounce to the deployed
# app. Whatever you put here must also be listed under Supabase ->
# Authentication -> URL Configuration -> Redirect URLs.
# site_url = "http://localhost:8501"
